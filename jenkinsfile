pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    stages {

        stage('Checkout') {
            steps{
                git 'https://github.com/abhisheksolanke97/student-management.git'
                echo "Clonning is Successful"
            }
        }

        stage('Build') {
            steps {
                sh '''
                    mvn clean package
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifacts to s3'){
            steps {
                sh 'aws s3 cp target/student-management.war s3://abhishek54321.space/Artifacts/student.war'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 1, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build --no-cache -t student .
                    docker images
                '''
            }
        }

        stage('Push to ECR') {
            steps{
                sh '''
                    aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 199731093942.dkr.ecr.ap-south-1.amazonaws.com
                    docker tag student:latest 199731093942.dkr.ecr.ap-south-1.amazonaws.com/student:latest
                    docker push 199731093942.dkr.ecr.ap-south-1.amazonaws.com/student:latest
                    '''
            }
        }

        stage('Deployment on Kubernetes') {
            steps {
                sh '''
                    aws eks update-kubeconfig --name my-eks-cluster --region ap-south-1
                    kubectl apply -f k8s/
                    kubectl get pods
                    sleep 30
                    kubectl get pods
                    kubectl get svc -o wide
                '''
            }
        }
    }
}