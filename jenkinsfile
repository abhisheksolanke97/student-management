pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'
    }
    stages{

        stage('checkout'){
            steps{
                git "https://github.com/abhisheksolanke97/student-management.git"
                echo "Clonning is Successful"
            }
        }
        stage('Build') {
            steps {
                sh '''
                  java --version
                  mvn --version
                  mvn clean package
                '''
            }
        }    
    }
}