pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }
    stages{

        stage('checkout'){
            steps{
                git "https://github.com/abhisheksolanke97/student-management.git"
                echo "Clonning is Successful"
            }
        }
        stage('Build') {
            steps {
                sh '''
                  mvn clean package 
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war',fingerprint: true
                }
            }
        }
        
        stage('Artifacts to s3') {
            steps {
                sh 'aws s3 cp target/*.war s3://abhishek54321.space/Artifacts/student-management.war'
            }
        } 
        
        stage('SonarQube Analysis'){
            steps {
                withSonarQubeEnv('sonar'){
                    sh 'mvn sonar:sonar'
                }
            }
        } 

        stage('Quality Gates') {
            steps {
                timeout(time:5, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }  

        stage('Docker Build') {
            steps {
                sh '''
                docker build --no-cashe -t student-management:v1 .
                docker images
                '''
            }
        }
    }
}
