pipeline {
agent {
label 'worker'
}

```
tools {
    maven 'mvn'
}

stages {

    stage('Checkout') {
        steps {
            git 'https://github.com/mayurpandit25/student-management.git'
            echo 'Cloning is successful'
        }
    }

    stage('Build') {
        steps {
            sh 'mvn clean package'
        }
    }

    stage('Test') {
        steps {
            sh 'mvn test'
        }
    }

    stage('Deploy') {
        steps {
            echo 'Deployment is successful'
        }
    }
}
```

}
